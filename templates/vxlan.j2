#!/bin/bash
set -eu

# Ensure the BATMAN mesh interface exists before binding VXLAN to it.
# br-welt also does this in ifup pre-up hooks, but vxlan.service starts first
# during boot and must be able to stand up the mesh path independently.
/sbin/modprobe batman_adv
/sbin/modprobe dummy

OUTBOUND_MAC="$(ip -br link show {{ outbound_lan_interface }} | awk '{print $3}')"

/usr/sbin/batctl ra {{ batman_protocol_mode }}

/sbin/ip link show {{ ff_batman_dummy_interface }} >/dev/null 2>&1 || \
  /sbin/ip link add {{ ff_batman_dummy_interface }} type dummy
if [ -n "${OUTBOUND_MAC}" ]; then
  /sbin/ip link set address "${OUTBOUND_MAC}" dev {{ ff_batman_dummy_interface }}
fi
/sbin/ip link set {{ ff_batman_dummy_interface }} up
/usr/sbin/batctl meshif {{ ff_batman_meshif }} if add {{ ff_batman_dummy_interface }} >/dev/null 2>&1 || true
/sbin/ip link set {{ ff_batman_meshif }} up
/usr/sbin/batctl meshif {{ ff_batman_meshif }} gw_mode client
if [ -n "${OUTBOUND_MAC}" ]; then
  /sbin/ip link set address "${OUTBOUND_MAC}" dev {{ ff_batman_meshif }}
fi

# Bring up VXLAN.
ip link show {{ ff_mesh_vpn_interface }} >/dev/null 2>&1 || \
  ip link add {{ ff_mesh_vpn_interface }} type vxlan id {{ vxlan_id }} local {{ slurp_wglinklocal.content | b64decode | trim }} remote {{ wg_endpoint_link }} dstport 8472 dev {{ ff_wireguard_interface }}
ip link set up dev {{ ff_mesh_vpn_interface }}

# Bind mesh-vpn to the BATMAN mesh interface.
/usr/sbin/batctl meshif {{ ff_batman_meshif }} if add {{ ff_mesh_vpn_interface }} >/dev/null 2>&1 || true

# BATMAN_V needs a useful throughput estimate for the VXLAN hard interface.
/usr/sbin/batctl hardif {{ ff_mesh_vpn_interface }} throughput_override 10000
